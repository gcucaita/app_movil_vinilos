<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:importantForAccessibility="yes"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_header" />

        <TextView
            android:id="@+id/tvAlbumsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/noto_serif_bold"
            android:lineSpacingExtra="-2sp"
            android:text="@string/albums_title"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:textStyle="bold"
            android:importantForAccessibility="yes" />

        <TextView
            android:id="@+id/tvAlbumsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:text="@string/albums_subtitle"
            android:textColor="@color/secondary_soft"
            android:textSize="18sp"
            android:importantForAccessibility="yes" />

        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:importantForAccessibility="yes"
            android:contentDescription="@string/cd_search_bar_albums">

            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/search"
                android:tint="@color/search_text"
                android:contentDescription="@string/cd_search_icon"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="@string/search_hint"
                android:textColor="@color/search_text"
                android:textColorHint="@color/search_text"
                android:textSize="18sp"
                android:fontFamily="@font/manrope_regular"
                android:inputType="text"
                android:background="@null"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/cd_search_input_albums" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:contentDescription="@string/cd_filters_scroll"
            android:importantForAccessibility="yes">

            <LinearLayout
                android:id="@+id/chipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:importantForAccessibility="yes" />

        </HorizontalScrollView>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/albums_error"
            android:textColor="@color/body_text"
            android:textSize="14sp"
            android:visibility="gone"
            android:importantForAccessibility="yes" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/albumsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:overScrollMode="never"
            android:importantForAccessibility="yes"
            tools:itemCount="8"
            tools:listitem="@layout/item_album" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabAdd"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="84dp"
        android:text="+"
        android:textSize="24sp"
        android:textColor="@color/green_accent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:padding="0dp"
        app:backgroundTint="@android:color/transparent"
        app:strokeColor="@color/green_accent"
        app:strokeWidth="2dp"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/cd_add_album"
        android:importantForAccessibility="yes" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/loadingIndicator"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/green_accent"
        android:visibility="gone"
        android:contentDescription="@string/cd_loading"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>