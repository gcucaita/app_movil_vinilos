<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:importantForAccessibility="yes">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_header"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tvCollectorsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/noto_serif_bold"
                android:text="@string/collectors_title"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes"/>

            <TextView
                android:id="@+id/tvCollectorsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:text="@string/collectors_subtitle"
                android:textColor="@color/secondary_soft"
                android:textSize="18sp"
                android:importantForAccessibility="yes"/>

            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/cd_search_collectors">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/search"
                    android:tint="@color/search_text"
                    android:contentDescription="@string/cd_search_icon"
                    android:importantForAccessibility="no"/>

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:hint="@string/search_hint"
                    android:textColor="@color/search_text"
                    android:textColorHint="@color/search_text"
                    android:textSize="18sp"
                    android:fontFamily="@font/manrope_regular"
                    android:inputType="text"
                    android:background="@null"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:importantForAccessibility="yes"
                    android:contentDescription="@string/cd_search_input_collectors"/>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/albums_error"
            android:textColor="@color/body_text"
            android:textSize="14sp"
            android:visibility="gone"
            android:paddingHorizontal="20dp"
            android:importantForAccessibility="yes"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collectorsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:overScrollMode="never"
            android:importantForAccessibility="yes"/>

    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/green_accent"
        android:visibility="gone"
        android:contentDescription="@string/cd_loading"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>