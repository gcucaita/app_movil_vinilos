<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:importantForAccessibility="yes">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:importantForAccessibility="yes"
        android:contentDescription="@string/cd_track_entry_scroll"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/toolbar"
                layout="@layout/view_header"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/track_entry_title"
                    android:textColor="@color/white"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="yes"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/track_entry_subtitle"
                    android:textColor="@color/meta_text"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:importantForAccessibility="yes"/>

                <!-- TRACK TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/track_title_label"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <EditText
                    android:id="@+id/etTrackName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/track_name_hint"
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"
                    android:importantForAccessibility="yes"
                    android:contentDescription="@string/cd_track_name_input"/>

                <!-- DURATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/track_duration_label"
                    android:textColor="@color/secondary_soft"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <EditText
                    android:id="@+id/etTrackDuration"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/track_duration_hint"
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"
                    android:importantForAccessibility="yes"
                    android:contentDescription="@string/cd_track_duration_input"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddTrack"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:text="@string/add_track"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:contentDescription="@string/cd_add_track"
                    app:backgroundTint="@color/green_accent"
                    app:cornerRadius="4dp"/>

                <!-- EXISTING TRACKS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvExistingTracks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/existing_tracks"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:importantForAccessibility="yes"/>

                    <TextView
                        android:id="@+id/tvTrackCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tracks_added"
                        android:textColor="@color/meta_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:importantForAccessibility="yes"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llTrackList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:importantForAccessibility="yes"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>