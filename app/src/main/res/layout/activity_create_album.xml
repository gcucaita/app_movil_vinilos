<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/toolbar"
                layout="@layout/view_header"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp">

                <!-- HEADER -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="New Release"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="CURATION INTERFACE / PHASE 07"
                    android:textColor="@color/meta_text"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"/>

                <!-- ALBUM NAME -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="ALBUM NAME"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <EditText
                    android:id="@+id/etAlbumName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="e.g. Midnight Synths"
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:textSize="16sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"/>

                <!-- ARTIST -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="ARTIST"
                    android:textColor="@color/secondary_soft"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <Spinner
                    android:id="@+id/spArtist"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"/>

                <!-- RELEASE DATE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="RELEASE DATE"
                    android:textColor="@color/secondary_soft"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <EditText
                    android:id="@+id/etReleaseDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="YYYY-MM-DD"
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:textSize="16sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"/>

                <!-- GENRE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="GENRE SELECTION"
                    android:textColor="@color/secondary_soft"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <Spinner
                    android:id="@+id/spGenre"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"/>

                <!-- RECORD LABEL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="RECORD LABEL"
                    android:textColor="@color/secondary_soft"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <Spinner
                    android:id="@+id/spRecordLabel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"/>

                <!-- DESCRIPTION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="CURATOR'S NOTES"
                    android:textColor="@color/secondary_soft"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="Describe the sonic texture and archiving importance..."
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"/>

                <!-- COVER URL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="COVER URL"
                    android:textColor="@color/secondary_soft"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <EditText
                    android:id="@+id/etCoverUrl"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="https://..."
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="textUri"/>

                <!-- ARCHIVE BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:text="⬡  Archivate Album"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:backgroundTint="@color/green_accent"
                    app:cornerRadius="4dp"/>

                <!-- DISCARD -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="DISCARD"
                    android:textColor="@color/meta_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:gravity="center"/>

                <!-- ARCHIVING GUIDELINES card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@color/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⊙  ARCHIVING GUIDELINES"
                        android:textColor="@color/green_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ensure all metadata is verified before archiving. Archiving adds this release to the global digital ledger for all collectors to discover."
                        android:textColor="@color/body_text"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>