<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/toolbar"
                layout="@layout/view_header"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/create_album_title"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:fontFamily="@font/noto_serif_bold"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/create_album_subtitle"
                    android:textColor="@color/secondary_soft"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/manrope_regular"/>

                <!-- NOMBRE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_album_name"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etAlbumName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_album_name"
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:textSize="16sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"
                    android:contentDescription="@string/cd_album_name"/>

                <!-- ARTISTA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_artist"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/spArtist"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:contentDescription="@string/cd_select_artist"/>

                <!-- FECHA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_release_date"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etReleaseDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_date"
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:inputType="text"
                    android:contentDescription="@string/cd_release_date"/>

                <!-- GÉNERO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_genre"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/spGenre"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:contentDescription="@string/cd_select_genre"/>

                <!-- DISQUERA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_label"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/spRecordLabel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:contentDescription="@string/cd_select_label"/>

                <!-- DESCRIPCIÓN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_description"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_description"
                    android:textColor="@color/white"
                    android:textColorHint="@color/transparent_font"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:contentDescription="@string/cd_description"/>

                <!-- PORTADA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_cover_url"
                    android:textColor="@color/green_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etCoverUrl"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_url"
                    android:textColor="@color/white"
                    android:inputType="textUri"
                    android:contentDescription="@string/cd_cover_url"/>

                <!-- BOTÓN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:text="@string/action_archive_album"
                    android:contentDescription="@string/cd_archive_album"
                    app:backgroundTint="@color/green_accent"
                    app:cornerRadius="4dp"/>

                <TextView
                    android:id="@+id/tvDiscard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/action_discard"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_discard"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>